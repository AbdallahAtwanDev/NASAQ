datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MAKER
  CUSTOMER
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ProductCategory {
  HANDMADE
  CRAFT_SUPPLIES
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  phone         String?
  passwordHash  String?
  image         String?
  role          Role           @default(CUSTOMER)
  emailVerified DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  accounts      Account[]
  sessions      Session[]
  makerProfile  MakerProfile?
  orders        Order[]
  customOrders  CustomOrder[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id        String    @id @default(uuid())
  slug      String    @unique
  labelAr   String
  labelEn   String
  imageUrl  String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Promotion {
  id              String    @id @default(uuid())
  title           String
  description     String?
  imageUrl        String?
  linkUrl         String?
  discountPercent Float?
  isActive        Boolean   @default(true)
  startsAt        DateTime?
  endsAt          DateTime?
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  labelAr   String?
  updatedAt DateTime @updatedAt
}

model MakerProfile {
  id                 String    @id @default(uuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandName          String
  bio                String?
  vodafoneCashNumber String?
  instapayHandle     String?
  commissionRate     Float     @default(15.0)
  salesPreviousMonth Int       @default(0)
  products           Product[]
  createdAt          DateTime  @default(now())
}

model Product {
  id            String          @id @default(uuid())
  title         String
  description   String
  price         Float
  salePrice     Float?
  category      ProductCategory @default(HANDMADE)
  subCategory   String?
  categoryId    String?
  categoryRef   Category?       @relation(fields: [categoryId], references: [id])
  images        String[]
  stock         Int             @default(1)
  isUniquePiece Boolean         @default(false)
  isPublished   Boolean         @default(true)
  isFeatured    Boolean         @default(false)
  makerId       String?
  maker         MakerProfile?   @relation(fields: [makerId], references: [id])
  orderItems    OrderItem[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model ShippingRate {
  id          String @id @default(uuid())
  governorate String @unique
  cost        Float
}

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique
  customerId      String
  customer        User          @relation(fields: [customerId], references: [id])
  totalAmount     Float
  shippingCost    Float
  governorate     String
  shippingAddress String
  phone           String
  paymentMethod   String
  receiptImageUrl String
  paymentStatus   PaymentStatus @default(PENDING)
  orderStatus     OrderStatus   @default(PREPARING)
  rejectionReason String?
  giftMessage     String?
  paymentDeadline DateTime
  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model CustomOrder {
  id              String    @id @default(uuid())
  customerId      String
  customer        User      @relation(fields: [customerId], references: [id])
  description     String
  referenceImages String[]
  estimatedBudget Float?
  targetDate      DateTime?
  status          String    @default("UNDER_REVIEW")
  quotedPrice     Float?
  adminNotes      String?
  createdAt       DateTime  @default(now())
}
